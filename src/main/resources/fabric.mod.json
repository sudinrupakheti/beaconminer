{
	"schemaVersion": 1,
	"id": "beaconminer",
	"version": "${version}",
	"name": "BeaconMiner",
	"description": "Automatically mines supporting mineral blocks when a beacon is mined.",
	"authors": [
		"Sudin"
	],
	"license": "CC0-1.0",
	"icon": "assets/beaconminer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"sudin.beaconminer.BeaconMiner"
		],
		"client": [
			"sudin.beaconminer.client.BeaconMinerClient"
		]
	},
	"mixins": [
		"beaconminer.mixins.json",
		{
			"config": "beaconminer.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
